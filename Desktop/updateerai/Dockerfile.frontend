# Build Stage
FROM node:20-alpine AS builder
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
# Build the React app
# We need to set the VITE_BACKEND_URL at build time if we want it hardcoded,
# BUT for Nginx serving, we usually use a relative path /api and proxy_pass in Nginx.
# So we'll leave it empty or default, and configure Nginx to proxy /api requests.
RUN npm run build

# Serve Stage
FROM nginx:alpine
COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
