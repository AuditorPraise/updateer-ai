# Frontend Configuration
VITE_BACKEND_URL=http://localhost:8080

# Resend Email Service
RESEND_API_KEY=your_resend_api_key_here
RESEND_WEBHOOK_SECRET=your_webhook_secret_here

# Cloudflare Tunnel Configuration
# Replace with your actual token from Cloudflare Dashboard -> Access -> Tunnels
TUNNEL_TOKEN=your_tunnel_token_here
# Replace with the domain you configured in Cloudflare Dashboard -> Tunnels -> Public Hostnames
CLOUDFLARE_TUNNEL_URL=https://logos.updateerai.fun

# Backend Configuration
# [REQUIRED] The Public URL of your Go Backend API
# This is used for the Unsubscribe Link to reach your server.
# It must point to your backend port (8080), NOT your MinIO/Image server.
# Example: https://api.updateerai.fun
APP_URL=http://localhost:8080

# Database Configuration
# Format: postgresql://user:password@host:port/database?sslmode=require
# DB_URL=postgresql://user:password@localhost:5432/updateerai?sslmode=disable

# MinIO Configuration
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=your_secure_minio_password_here
MINIO_BUCKET_NAME=browser

# AWS S3 (alternative to MinIO)
# S3_ENDPOINT=s3.amazonaws.com
# S3_REGION=us-east-1
# S3_ACCESS_KEY=your_access_key
# S3_SECRET_KEY=your_secret_key
# S3_USE_SSL=true

# Logging Configuration
# LOG_LEVEL: debug, info (default), warn, error
LOG_LEVEL=info
# LOG_FORMAT: text (default), json
LOG_FORMAT=text
